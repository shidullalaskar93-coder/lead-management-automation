# ==========================================
# Lead Management Automation - Environment Config
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true

# Database Storage
# Use SQLite file or PostgreSQL/MySQL connection string
DATABASE_URL=sqlite:///data/pipeline.db

# Dead-Letter Queue Configuration
DLQ_STORAGE_FILE=data/failed_leads.jsonl
DLQ_MAX_RETRIES=3

# Lead Scoring Thresholds (0 - 100)
SCORE_HOT_THRESHOLD=75
SCORE_WARM_THRESHOLD=45

# Follow-Up SLA Settings
HOT_SLA_MINUTES=15
WARM_SLA_HOURS=4
COLD_SLA_DAYS=1

# Deduplication Window (in days)
DEDUPLICATION_WINDOW_DAYS=30

# External CRM Sync Simulation Settings
CRM_SYNC_MAX_RETRIES=3
CRM_SYNC_BASE_DELAY_SECONDS=0.5
CRM_SYNC_MAX_DELAY_SECONDS=4.0
CRM_SIMULATE_FAILURE_RATE=0.0
